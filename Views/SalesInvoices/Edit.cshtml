@model AccountingSystem.Models.SalesInvoice

@{
    var details = Model.Details.ToList();
}

<div class="page-header">
    <div>
        <h1>تعديل فاتورة بيع</h1>
        <p class="text-muted">تعديل بيانات وتفاصيل فاتورة المبيعات</p>
    </div>
</div>

<div class="card">

    <div class="card-header">
        <h2 class="card-title">بيانات الفاتورة</h2>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden"
               asp-for="SalesInvoiceId" />

          @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"
         class="alert alert-danger">
    </div>
}

        <div class="invoice-header-grid">

            <div class="form-group">
                <label class="form-label">رقم الفاتورة</label>

                <input asp-for="InvoiceNumber"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">التاريخ</label>

                <input asp-for="InvoiceDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">الدفع</label>

                <select asp-for="PaymentType"
                        class="form-select">

                    <option value="نقد">نقد</option>
                    <option value="أجل">أجل</option>

                </select>
            </div>

            <div class="form-group">
                <label class="form-label">الحساب</label>

                <select asp-for="AccountId"
                        class="form-select">

                    @foreach (var account in ViewBag.Accounts)
                    {
                        if (account.AccountId == Model.AccountId)
                        {
                            <option value="@account.AccountId"
                                    selected>
                                @account.AccountNumber -
                                @account.AccountName
                            </option>
                        }
                        else
                        {
                            <option value="@account.AccountId">
                                @account.AccountNumber -
                                @account.AccountName
                            </option>
                        }
                    }

                </select>
            </div>

        </div>

        <div class="invoice-details-card">

            <div class="card-header">
                <h2 class="card-title">تفاصيل الفاتورة</h2>
            </div>

            <div class="table-container">

                <table class="table invoice-table">

                    <thead>
                        <tr>
                            <th>الصنف</th>
                            <th>الكمية</th>
                            <th>سعر الوحدة</th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (int i = 0; i < details.Count; i++)
                        {
                            <tr>

                                <td>
                                    <select name="Details[@i].ItemId"
                                            class="form-select">

                                        @foreach (var item in ViewBag.Items)
                                        {
                                            if (item.ItemId == details[i].ItemId)
                                            {
                                                <option value="@item.ItemId"
                                                        selected>
                                                    @item.ItemName
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@item.ItemId">
                                                    @item.ItemName
                                                </option>
                                            }
                                        }

                                    </select>
                                </td>

                                <td>
                                    <input name="Details[@i].Quantity"
                                           value="@details[i].Quantity"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />
                                </td>

                                <td>
                                    <input name="Details[@i].UnitPrice"
                                           value="@details[i].UnitPrice"
                                           class="form-control"
                                           type="number"
                                           step="0.01" />
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                حفظ التعديل
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                إلغاء
            </a>

        </div>

    </form>

</div>