@model IEnumerable<AccountingSystem.Models.SalesInvoice>

<div class="page-header">
    <div>
        <h1>فواتير المبيعات</h1>
        <p class="text-muted">إدارة ومتابعة فواتير المبيعات</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        إضافة فاتورة بيع
    </a>
</div>

<div class="card">

    <div class="card-header">
        <div>
            <h2 class="card-title">فواتير المبيعات</h2>
            <span class="text-muted">
                إجمالي الفواتير: @Model.Count()
            </span>
        </div>
    </div>

    <div class="table-container">

        <table class="table">

            <thead>
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>التاريخ</th>
                    <th>الدفع</th>
                    <th>الحساب</th>
                    <th>الإجمالي</th>
                    <th>تعديل</th>
                    <th>حذف</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var invoice in Model)
                {
                    <tr>

                        <td>
                            @invoice.InvoiceNumber
                        </td>

                        <td>
                            @invoice.InvoiceDate.ToShortDateString()
                        </td>

                        <td>
                            @invoice.PaymentType
                        </td>

                        <td>
                            @invoice.Account?.AccountName
                        </td>

                        <td>
                            @invoice.Details.Sum(
                                x => x.Quantity * x.UnitPrice
                            )
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@invoice.SalesInvoiceId"
                               class="btn btn-secondary">
                                تعديل
                            </a>
                        </td>

                        <td>
                            <form asp-action="Delete"
                                  asp-route-id="@invoice.SalesInvoiceId"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger">
                                    حذف
                                </button>

                            </form>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>