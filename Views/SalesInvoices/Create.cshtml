@model AccountingSystem.Models.SalesInvoice

@{
    var accounts = ViewBag.Accounts as IEnumerable<AccountingSystem.Models.Account>
                   ?? Enumerable.Empty<AccountingSystem.Models.Account>();

    var items = ViewBag.Items as IEnumerable<AccountingSystem.Models.Item>
                ?? Enumerable.Empty<AccountingSystem.Models.Item>();
}

<div class="page-header">
    <div>
        <h1>إضافة فاتورة بيع</h1>
        <p class="text-muted">إنشاء فاتورة مبيعات جديدة</p>
    </div>
</div>

<div class="card">

    <div class="card-header">
        <h2 class="card-title">بيانات الفاتورة</h2>
    </div>

    <form asp-action="Create" method="post">

          @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"
         class="alert alert-danger">
    </div>
}

        <div class="invoice-header-grid">

            <div class="form-group">
                <label class="form-label">رقم الفاتورة</label>

                <input asp-for="InvoiceNumber"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">التاريخ</label>

                <input asp-for="InvoiceDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">الدفع</label>

                <select asp-for="PaymentType"
                        class="form-select">

                    <option value="نقد">نقد</option>
                    <option value="أجل">أجل</option>

                </select>
            </div>

            <div class="form-group">
                <label class="form-label">الحساب</label>

                <select asp-for="AccountId"
                        class="form-select">

                    <option value="">
                        -- اختر الحساب --
                    </option>

                    @foreach (var account in accounts)
                    {
                        <option value="@account.AccountId">
                            @account.AccountNumber - @account.AccountName
                        </option>
                    }

                </select>
            </div>

        </div>

        <div class="invoice-details-card">

            <div class="card-header">
                <h2 class="card-title">تفاصيل الفاتورة</h2>
            </div>

            <div class="table-container">

                <table class="table invoice-table">

                    <thead>
                        <tr>
                            <th>الصنف</th>
                            <th>الوحدة</th>
                            <th>الكمية</th>
                            <th>سعر الوحدة</th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (int i = 0; i < 5; i++)
                        {
                            <tr>

                                <td>
                                    <select name="Details[@i].ItemId"
                                            class="form-select item-select"
                                            data-unit-target="unit-@i">

                                        <option value="">
                                            -- اختر الصنف --
                                        </option>

                                        @foreach (var item in items)
                                        {
                                            <option value="@item.ItemId"
                                                    data-unit="@item.Unit">
                                                @item.ItemName
                                            </option>
                                        }

                                    </select>
                                </td>

                                <td>
                                    <input type="text"
                                           id="unit-@i"
                                           class="form-control unit-input"
                                           readonly />
                                </td>

                                <td>
                                    <input name="Details[@i].Quantity"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />
                                </td>

                                <td>
                                    <input name="Details[@i].UnitPrice"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                حفظ الفاتورة
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                إلغاء
            </a>

        </div>

    </form>

</div>

<script>
    document.querySelectorAll(".item-select").forEach(function (select) {

        select.addEventListener("change", function () {

            var selectedOption =
                this.options[this.selectedIndex];

            var unit =
                selectedOption.getAttribute("data-unit") || "";

            var targetId =
                this.getAttribute("data-unit-target");

            document.getElementById(targetId).value = unit;
        });

    });
</script>