<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - نظام المحاسبة</title>

    <link rel="stylesheet" href="~/css/variables.css" />
    <link rel="stylesheet" href="~/css/base.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/pages.css" />
    <link rel="stylesheet" href="~/css/pages/reports.css"/>
</head>

<body>

    <!-- Header -->
    <header class="app-header">

        <div class="app-logo">
            <span>نظام المحاسبة</span>
        </div>

        <div class="app-header-title">
            @ViewData["Title"]
        </div>

    </header>


    <!-- Application Container -->
    <div class="app-container">

        <!-- Sidebar -->
        <aside class="sidebar">

            <nav class="sidebar-nav">

                <a class="sidebar-link"
                   asp-controller="Home"
                   asp-action="Index">
                    الرئيسية
                </a>

                <a class="sidebar-link"
                   asp-controller="Accounts"
                   asp-action="Index">
                    دليل الحسابات
                </a>

                <a class="sidebar-link"
                   asp-controller="Items"
                   asp-action="Index">
                    دليل الأصناف
                </a>

                <a class="sidebar-link"
                   asp-controller="ReceiptVouchers"
                   asp-action="Index">
                    سندات القبض
                </a>

                <a class="sidebar-link"
                   asp-controller="PaymentVouchers"
                   asp-action="Index">
                    سندات الصرف
                </a>

                <a class="sidebar-link"
                   asp-controller="PurchaseInvoices"
                   asp-action="Index">
                    فواتير المشتريات
                </a>

                <a class="sidebar-link"
                   asp-controller="SalesInvoices"
                   asp-action="Index">
                    فواتير المبيعات
                </a>

                <a class="sidebar-link"
                   asp-controller="Reports"
                   asp-action="Inventory">
                    تقرير المخزون
                </a>

                <a class="sidebar-link"
                   asp-controller="Reports"
                   asp-action="AccountStatement">
                    كشف الحساب
                </a>

            </nav>

        </aside>


        <!-- Main Content -->
        <main class="main-content">

            <div class="page-container">

                @RenderBody()

            </div>

        </main>

    </div>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>