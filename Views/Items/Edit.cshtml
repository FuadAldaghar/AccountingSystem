@model AccountingSystem.Models.Item

<div class="page-header">
    <div>
        <h1>تعديل صنف</h1>
        <p class="text-muted">تعديل بيانات الصنف</p>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">بيانات الصنف</h2>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="ItemId" />

        <div class="form-group">
            <label class="form-label">رقم الصنف</label>

            <input asp-for="ItemNumber"
                   class="form-control" />

            <span asp-validation-for="ItemNumber"
                  class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label">اسم الصنف</label>

            <input asp-for="ItemName"
                   class="form-control" />

            <span asp-validation-for="ItemName"
                  class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label">الوحدة</label>

            <input asp-for="Unit"
                   class="form-control" />

            <span asp-validation-for="Unit"
                  class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit"
                    class="btn btn-primary">
                حفظ التعديل
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                إلغاء
            </a>
        </div>

    </form>
</div>