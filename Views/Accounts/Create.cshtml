
@model AccountingSystem.Models.Account

<div class="page-header">

    <div>
        <h1>إضافة حساب</h1>
        <p class="text-muted">
            إضافة حساب جديد إلى دليل الحسابات
        </p>
    </div>

</div>


<div class="card">

    <div class="card-header">
        <h2 class="card-title">بيانات الحساب</h2>
    </div>


    <form asp-action="Create" method="post">

        <div class="form-group">

            <label class="form-label">
                رقم الحساب
            </label>

            <input asp-for="AccountNumber"
                   class="form-control" />

            <span asp-validation-for="AccountNumber"
                  class="text-danger">
            </span>

        </div>


        <div class="form-group">

            <label class="form-label">
                اسم الحساب
            </label>

            <input asp-for="AccountName"
                   class="form-control" />

            <span asp-validation-for="AccountName"
                  class="text-danger">
            </span>

        </div>


        <div class="form-group">

            <label class="form-label">
                نوع الحساب
            </label>

            <input asp-for="AccountType"
                   class="form-control" />

            <span asp-validation-for="AccountType"
                  class="text-danger">
            </span>

        </div>


        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                حفظ
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                إلغاء
            </a>

        </div>

    </form>

</div>

