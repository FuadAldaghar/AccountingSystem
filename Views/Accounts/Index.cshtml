@model IEnumerable<AccountingSystem.Models.Account>

<div class="page-header">

    <div>
        <h1>دليل الحسابات</h1>
        <p class="text-muted">
            إدارة الحسابات المسجلة في النظام
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        إضافة حساب جديد
    </a>

</div>


<div class="card">

    <div class="card-header">

        <div>
            <h2 class="card-title">الحسابات</h2>
            <span class="text-muted">
                إجمالي الحسابات: @Model.Count()
            </span>
        </div>

    </div>


    <div class="table-container">

        <table class="table">

            <thead>
                <tr>
                    <th>رقم الحساب</th>
                    <th>اسم الحساب</th>
                    <th>نوع الحساب</th>
                    <th>الإجراءات</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var account in Model)
                {
                    <tr>

                        <td>
                            @account.AccountNumber
                        </td>

                        <td>
                            @account.AccountName
                        </td>

                        <td>
                            <span class="badge badge-info">
                                @account.AccountType
                            </span>
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@account.AccountId"
                               class="btn btn-secondary">
                                تعديل
                            </a>
                            </td>
                         <td>
                            <form asp-action="Delete"
                                  asp-route-id="@account.AccountId"
                                  method="post"
                                  style="display:inline">

                                <button type="submit"
                                        class="btn btn-danger">
                                    حذف
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>