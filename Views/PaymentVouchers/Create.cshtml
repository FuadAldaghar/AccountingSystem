@model AccountingSystem.Models.PaymentVoucher

<div class="page-header">
    <div>
        <h1>إضافة سند صرف</h1>
        <p class="text-muted">إضافة سند صرف جديد إلى النظام</p>
    </div>
</div>

<div class="card">

    <div class="card-header">
        <h2 class="card-title">بيانات سند الصرف</h2>
    </div>

    <form asp-action="Create" method="post">

        <div class="form-group">
            <label class="form-label">رقم السند</label>

            <input asp-for="VoucherNumber"
                   class="form-control" />

            <span asp-validation-for="VoucherNumber"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label class="form-label">التاريخ</label>

            <input asp-for="VoucherDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="VoucherDate"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label class="form-label">المبلغ</label>

            <input asp-for="Amount"
                   type="number"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Amount"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label class="form-label">الحساب</label>

            <select asp-for="AccountId"
                    class="form-select">

                <option value="">
                    -- اختر الحساب --
                </option>

                @foreach (var account in ViewBag.Accounts)
                {
                    <option value="@account.AccountId">
                        @account.AccountNumber - @account.AccountName
                    </option>
                }

            </select>

            <span asp-validation-for="AccountId"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label class="form-label">ملاحظات</label>

            <textarea asp-for="Notes"
                      class="form-control">
            </textarea>
        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                حفظ
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                إلغاء
            </a>

        </div>

    </form>

</div>