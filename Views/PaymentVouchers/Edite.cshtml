@model AccountingSystem.Models.PaymentVoucher

<h1>تعديل سند صرف</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="PaymentVoucherId" />

    <div>
        <label>رقم السند</label>
        <input asp-for="VoucherNumber" />
    </div>

    <br />

    <div>
        <label>التاريخ</label>
        <input asp-for="VoucherDate" type="date" />
    </div>

    <br />

    <div>
        <label>المبلغ</label>
        <input asp-for="Amount" type="number" step="0.01" />
    </div>

    <br />

    <div>
        <label>الحساب</label>

        <select asp-for="AccountId">

            @foreach (var account in ViewBag.Accounts)
            {
                <option value="@account.AccountId">
                    @account.AccountNumber - @account.AccountName
                </option>
            }

        </select>
    </div>

    <br />

    <div>
        <label>ملاحظات</label>
        <textarea asp-for="Notes"></textarea>
    </div>

    <br />

    <button type="submit">حفظ التعديل</button>

    <a asp-action="Index">إلغاء</a>

</form>