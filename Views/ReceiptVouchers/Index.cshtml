@model IEnumerable<AccountingSystem.Models.ReceiptVoucher>

<div class="page-header">
    <div>
        <h1>سندات القبض</h1>
        <p class="text-muted">إدارة سندات القبض المسجلة في النظام</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        إضافة سند قبض
    </a>
</div>

<div class="card">

    <div class="card-header">
        <div>
            <h2 class="card-title">سندات القبض</h2>
            <span class="text-muted">
                إجمالي السندات: @Model.Count()
            </span>
        </div>
    </div>

    <div class="table-container">

        <table class="table">

            <thead>
                <tr>
                    <th>رقم السند</th>
                    <th>التاريخ</th>
                    <th>المبلغ</th>
                    <th>اسم الحساب</th>
                    <th>ملاحظات</th>
                    <th>تعديل</th>
                    <th>حذف</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var voucher in Model)
                {
                    <tr>

                        <td>@voucher.VoucherNumber</td>

                        <td>
                            @voucher.VoucherDate.ToShortDateString()
                        </td>

                        <td>
                            <strong>@voucher.Amount</strong>
                        </td>

                        <td>
                            @voucher.Account?.AccountName
                        </td>

                        <td>
                            @voucher.Notes
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@voucher.ReceiptVoucherId"
                               class="btn btn-secondary">
                                تعديل
                            </a>
                        </td>

                        <td>
                            <form asp-action="Delete"
                                  asp-route-id="@voucher.ReceiptVoucherId"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger">
                                    حذف
                                </button>

                            </form>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>